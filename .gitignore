# ================= 依赖 =================
# 不带前缀斜杠的规则会匹配任意层级，一条就够
node_modules/

# ================= 构建产物 =================
dist/
dist-ssr/
*.tsbuildinfo

# ================= 日志 =================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================= 环境变量 =================
# 带密钥的绝不提交
genui-backend/config/.env.production
# 下面两行是建议项：如果你想让别人 clone 后直接能跑，就删掉它们
genui-backend/config/.env.development
genui-backend/config/.env.test

# ================= 测试产物 =================
# 每次跑测试都会重写
genui-backend/src/repos/common/database.test.json
genui-protocol/test/

# ================= 操作系统 =================
.DS_Store
Thumbs.db
desktop.ini

# ================= 编辑器 =================
.idea/
.vscode/*
!.vscode/extensions.json

# ================= 杂项 =================
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
